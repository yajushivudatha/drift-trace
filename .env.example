# Copy to .env. Required: ANTHROPIC_API_KEY, LLM_MODEL, CONTACT_EMAIL.

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# USD per million tokens for LLM_MODEL. Used only for the cost counters.
LLM_PRICE_INPUT_PER_MTOK=4
LLM_PRICE_OUTPUT_PER_MTOK=20
# low, medium, high, xhigh or max. Leave a value empty for models without effort control.
LLM_EFFORT_EXTRACT=low
LLM_EFFORT_RERANK=low
LLM_EFFORT_JUDGE=high
# Reroute a request to a fallback model if the safety classifier declines biomedical text.
LLM_REFUSAL_FALLBACK=true
# Judge each hop twice with passages reordered. Disagreement lowers confidence. Doubles judge cost.
JUDGE_DOUBLE_CHECK=false

# Sent to OpenAlex, Crossref and Unpaywall as their polite-use contact. Unpaywall requires it.
CONTACT_EMAIL=
# Optional, raises rate limits.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=

EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_DIM=768

POSTGRES_PASSWORD=drifttrace
